{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/run-birthday-check",
      "schedule": "30 3 * * *"
    }
  ]
}